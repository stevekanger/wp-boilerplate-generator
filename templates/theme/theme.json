{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "appearanceTools": true,
    "color": {
      "text": true,
      "gradients": [
        {
          "name": "Dark to Transparent",
          "slug": "gradient-dark-to-transparent",
          "gradient": "linear-gradient(to bottom, #030712, transparent)"
        },
        {
          "name": "Primary to Secondary",
          "slug": "gradient-primary-to-secondary",
          "gradient": "linear-gradient(135deg, #432dd7, #7008e7)"
        },
        {
          "name": "Light to Dark",
          "slug": "gradient-light-to-dark",
          "gradient": "linear-gradient(to bottom, #fafafa , #030712)"
        }
      ],
      "duotone": [
        {
          "name": "Primary to Secondary",
          "slug": "duotone-primary-to-secondary",
          "colors": [
            "#432dd7",
            "#7008e7"
          ]
        }
      ],
      "palette": [
        {
          "color": "#fafafa",
          "name": "Background Primary",
          "slug": "background-primary"
        },
        {
          "color": "#030712",
          "name": "Background Secondary",
          "slug": "background-secondary"
        },
        {
          "color": "#09090b",
          "name": "Text Primary",
          "slug": "text-primary"
        },
        {
          "color": "#d4d4d4",
          "name": "Text Secondary",
          "slug": "text-secondary"
        },
        {
          "color": "#432dd7",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#7008e7",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "name": "Transparent",
          "color": "transparent",
          "slug": "transparent"
        }
      ]
    },
    "layout": {
      "contentSize": "650px",
      "wideSize": "1200px"
    },
    "custom": {
      "fontWeight": {
        "black": 900,
        "extraBold": 800,
        "bold": 700,
        "semiBold": 600,
        "medium": 500,
        "regular": 400,
        "light": 300,
        "extraLight": 200,
        "thin": 100
      },
      "lineHeight": {
        "initial": 1,
        "xs": 1.2,
        "sm": 1.3,
        "md": 1.4,
        "lg": 1.45,
        "xl": 1.6,
        "2-xl": 1.8
      },
      "borderRadius": {
        "xs": "0.125rem",
        "sm": "0.25rem",
        "md": "0.375rem ",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "2-xl": "1rem",
        "full": "9999px"
      }
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ],
      "spacingScale": {
        "operator": "*",
        "increment": 0,
        "steps": 0,
        "mediumStep": 0,
        "unit": "px"
      },
      "spacingSizes": [
        {
          "name": "xs",
          "slug": "xs",
          "size": "0.25rem"
        },
        {
          "name": "sm",
          "slug": "sm",
          "size": "0.5rem"
        },
        {
          "name": "md",
          "slug": "md",
          "size": "1rem"
        },
        {
          "name": "lg",
          "slug": "lg",
          "size": "1.5rem"
        },
        {
          "name": "xl",
          "slug": "xl",
          "size": "3rem"
        },
        {
          "name": "2xl",
          "slug": "2-xl",
          "size": "5rem"
        },
        {
          "name": "3xl",
          "slug": "3-xl",
          "size": "10rem"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "dropCap": true,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textAlign": true,
      "textColumns": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", sans-serif",
          "name": "Inter",
          "slug": "inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "100",
              "src": [
                "file:./assets/fonts/Inter/Inter-Thin.woff2"
              ]
            },
            {
              "fontFamily": "Inter",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "300",
              "src": [
                "file:./assets/fonts/Inter/Inter-Light.woff2"
              ]
            },
            {
              "fontFamily": "Inter",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/Inter/Inter-Regular.woff2"
              ]
            },
            {
              "fontFamily": "Inter",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "500",
              "src": [
                "file:./assets/fonts/Inter/Inter-Medium.woff2"
              ]
            },
            {
              "fontFamily": "Inter",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": [
                "file:./assets/fonts/Inter/Inter-SemiBold.woff2"
              ]
            },
            {
              "fontFamily": "Inter",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": [
                "file:./assets/fonts/Inter/Inter-Bold.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"DrukWideSuper\", sans-serif",
          "name": "Druk Wide Super",
          "slug": "druk-wide-super",
          "fontFace": [
            {
              "fontFamily": "DrukWideSuper",
              "fontStretch": "",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/DrukWideSuper/DrukWideSuper.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "sm",
          "size": "clamp(14px, 1.6vw, 16px)",
          "slug": "sm",
          "fluid": {
            "min": "14px",
            "max": "16px"
          }
        },
        {
          "name": "md",
          "size": "clamp(16px, 1.8vw, 18px)",
          "slug": "md",
          "fluid": {
            "min": "16px",
            "max": "18px"
          }
        },
        {
          "name": "lg",
          "size": "clamp(20px, 2.4vw, 24px)",
          "slug": "lg",
          "fluid": {
            "min": "20px",
            "max": "24px"
          }
        },
        {
          "name": "xl",
          "size": "clamp(24px, 3.2vw, 32px)",
          "slug": "xl",
          "fluid": {
            "min": "24px",
            "max": "32px"
          }
        },
        {
          "name": "2xl",
          "size": "clamp(30px, 4vw, 40px)",
          "slug": "2-xl",
          "fluid": {
            "min": "32px",
            "max": "40px"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background-primary",
      "text": "var:preset|color|text-primary"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|xs",
      "margin": {
        "bottom": "0px",
        "left": "0px",
        "right": "0px",
        "top": "0px"
      },
      "padding": {
        "bottom": "0px",
        "left": "clamp(16px, 4vw, 32px)",
        "right": "clamp(16px, 4vw, 32px)",
        "top": "0px"
      }
    },
    "typography": {
      "fontSize": "var:preset|font-size|md",
      "fontFamily": "var:preset|font-family|inter",
      "fontWeight": "var:custom|font-weight|regular",
      "lineHeight": "var:custom|line-height|xl"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        ":hover": {
          "color": {
            "text": "color-mix(in srgb, var(--wp--preset--color--primary) 70%, white)"
          }
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "fontWeight": "var:custom|font-weight|regular",
          "lineHeight": "var:custom|line-height|initial"
        },
        "color": {
          "background": "var:preset|color|transparent",
          "text": "var:preset|color|text-primary"
        },
        "border": {
          "radius": "var:custom|border-radius|sm",
          "color": "var:preset|color|primary",
          "width": "2px",
          "style": "solid"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|transparent",
            "text": "var:preset|color|text-primary"
          },
          "border": {
            "color": "color-mix(in srgb, var(--wp--preset--color--primary) 70%, white)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|2-xl",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|xs",
          "letterSpacing": "-2px"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|md",
            "bottom": "var:preset|spacing|md"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xl",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|xs",
          "letterSpacing": "-1px"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|md",
            "bottom": "var:preset|spacing|md"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|lg",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|sm",
          "letterSpacing": "-0.5px"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|md",
            "bottom": "var:preset|spacing|md"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|sm",
          "letterSpacing": "-0.25px"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|md",
            "bottom": "var:preset|spacing|md"
          }
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|lg"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|md",
            "bottom": "var:preset|spacing|md"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|lg"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|md",
            "bottom": "var:preset|spacing|md"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "spacing": {
          "blockGap": "var:preset|spacing|md",
          "margin": {
            "bottom": "var:preset|spacing|md",
            "left": "0px",
            "right": "0px",
            "top": "var:preset|spacing|md"
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "fontWeight": "var:custom|font-weight|semi-bold",
          "lineHeight": "var:custom|line-height|xl",
          "letterSpacing": "0"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|primary"
            },
            ":hover": {
              "color": {
                "text": "color-mix(in srgb, var(--wp--preset--color--primary) 70%, white)"
              }
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "fontWeight": "var:custom|font-weight|regular",
          "lineHeight": "var:custom|line-height|lg",
          "letterSpacing": "0.25px"
        },
        "spacing": {
          "blockGap": "var:preset|spacing|md"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|primary"
            },
            ":hover": {
              "color": {
                "text": "var:preset|color|secondary"
              }
            }
          }
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|sm"
        }
      },
      "core/post-author": {
        "typography": {
          "fontSize": "var:preset|font-size|sm"
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|sm"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "fontWeight": "var:custom|font-weight|regular",
          "lineHeight": "var:custom|line-height|initial"
        },
        "color": {
          "text": "var:preset|color|text-primary"
        }
      },
      "core/separator": {
        "color": {
          "background": "var:preset|color|text-primary"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
