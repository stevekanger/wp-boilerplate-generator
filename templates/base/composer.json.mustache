{
  "name": "{{authorHandle}}/{{slug}}",
  "description": "{{description}}",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "{{phpNamespace}}\\": "inc/app/"
    }
  },
{{#installTests}}
  "autoload-dev": {
    "psr-4": {
      "{{phpNamespace}}\\Tests\\": "tests/php/"
    }
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wordpress/wordpress-tests-phpunit",
        "version": "{{wordpressVersion}}",
        "source": {
          "url": "https://develop.svn.wordpress.org/tags/{{wordpressVersion}}/tests/",
          "type": "svn",
          "reference": "phpunit/"
        }
      }
    }
  ],
  "scripts": {
    "test": "docker exec -it -w /var/www/html/wp-content/{{wpContentLocation}}/{{slug}} {{slug}}-wordpress-test ./vendor/bin/phpunit"
  },
{{/installTests}}
  "require": {
    "php": ">={{phpVersion}}"
  },
  "require-dev": {
{{#installTests}}
    "phpunit/phpunit": "^9.6.34",
    "yoast/phpunit-polyfills": "^4.0",
    "vlucas/phpdotenv": "^5.6",
    "wordpress/wordpress-tests-phpunit": "{{wordpressVersion}}",
{{/installTests}}
    "stevekanger/sk-php-cs-fixers": "^0.1.2"
  }
}
